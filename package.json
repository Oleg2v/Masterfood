{
  "name": "masterfood-portal",
  "version": "0.1.0",
  "private": true,
  "description": "השוק של מחר — pitch concept of a B2B ordering portal for Masterfood. Concept by Kikkey; not the official Masterfood website. Demo prices only.",
  "scripts": {
    "tokens": "node --experimental-strip-types --no-warnings scripts/generate-tokens.ts",
    "predev": "npm run tokens",
    "dev": "next dev",
    "prebuild": "npm run tokens",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node --experimental-strip-types --no-warnings scripts/check-contrast.ts",
    "check:copy": "node --experimental-strip-types --no-warnings scripts/check-copy.ts",
    "shots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "axe-core": "4.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
