# Cloudflare Workers static assets: response headers for every file.
# Demo hygiene: an unlisted pitch concept, never indexed, never archived.
/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Hashed build output never changes, so it can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
